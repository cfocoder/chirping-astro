# Copy to .env and replace every placeholder before deploying. Never commit the real .env.
# DATA_ROOT is a dedicated persistent directory owned and protected by the host.
DATA_ROOT=/srv/helicalinsight

# Helical Insight v7.0.0 expects this fixed internal PostgreSQL user/database pair.
POSTGRES_USER=hiuser
POSTGRES_DB=hiee
# Use the private value compatible with the packaged v7.0.0 datasource contract.
# Do not use an arbitrary value and never publish the real value.
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_PACKAGE_COMPATIBLE_VALUE

# Private route consumed by the packaged application; omit scheme and path.
HOST_IP=private-hostname:18085
HELICAL_HOST_PORT=18085
# Reserved documentation address. Replace with your private Tailscale address.
TAILSCALE_IP=192.0.2.10

# Separate host directory containing the Oracle mTLS wallet. This is mounted read-only.
# Do not store it under version control or in Coolify variables.
ORACLE_WALLET_DIR=/private/path/to/oracle-wallet

# Start safely with synthetic or approved data and no real external LLM.
HELICALBI_LLM_MODE=stub
INSTALL_CHROME=false
